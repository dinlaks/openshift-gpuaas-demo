# GPU Booking Plugin — values template
# Auto-generated by deploy.sh from env.sh variables.
# Do NOT edit this file directly — edit values.yaml.template.

image:
  repository: quay.io/eformat/gpu-booking-plugin
  tag: latest
  pullPolicy: Always

tls:
  enabled: true

enablePlugin: true

kueue:
  syncEnabled: true
  syncIntervalSeconds: 30
  syncDays: 7

bookingWindowDays: 30

gpuDiscovery:
  enabled: true
  intervalSeconds: 600

# GPU resource definitions — auto-resolved from GPU_TYPE in env.sh
gpuConfig:
  resources:
    - name: "${GPU_ARCH_UPPER} Full GPU (${GPU_MEMORY})"
      type: "${FULL_GPU_RESOURCE}"
      count: ${GPU_FULL_COUNT}
      share: 1.0
      gpuEquivalent: 1.0
    - name: "${GPU_ARCH_UPPER} MIG Small (${MIG_SMALL_RESOURCE})"
      type: "${MIG_SMALL_RESOURCE}"
      count: ${MIG_SMALL_COUNT}
      share: 0.167
      gpuEquivalent: 0.167
    - name: "${GPU_ARCH_UPPER} MIG Large (${MIG_LARGE_RESOURCE})"
      type: "${MIG_LARGE_RESOURCE}"
      count: ${MIG_LARGE_COUNT}
      share: 0.333
      gpuEquivalent: 0.333

persistence:
  enabled: true
  storageClass: "${DEFAULT_STORAGECLASS}"
  size: 2Gi

cohort: gpuaas-cohort
